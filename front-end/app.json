{
  "expo": {
    "newArchEnabled": true,
    "name": "Autofacil",
    "slug": "autofacil",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "scheme": "autofacil",
    "jsEngine": "hermes",
    "experiments": {
      "tsconfigPaths": true
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "config": {
        "enableOnBackInvokedCallback": false
      },
      "package": "com.autofacil"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "282874a8-affa-4c12-bad0-9f439b5a6492"
      }
    },
    "owner": "igorlirap",
    "updates": {
      "url": "https://u.expo.dev/11853cd2-a6e3-4b02-8a81-29938150b8a1"
    }
  }
}
